# ── OpenAI API ──────────────────────────────
# OpenAI API 키 (ChatGPT·text-embedding-3-small 사용 시 필수)
OPENAI_API_KEY=sk-your-api-key-here

# ── 모델 설정 ────────────────────────────
# 모드: A=LLM only, B=LLM+RAG, C=LLM+RAG+LoRA
MODEL_MODE=C

# 추론 백엔드: openai 또는 qwen (로컬)
MODEL_BACKEND=qwen

# HuggingFace 모델 ID 또는 로컬 경로
MODEL_PATH=Qwen/Qwen2.5-7B-Instruct

# LoRA 어댑터 경로 (모드 C 전용, 선택사항)
LORA_ADAPTER_PATH=src/training/lora_final

# OpenAI 백엔드 사용 시 모델명
OPENAI_MODEL=gpt-4o-mini

# 생성 설정
MAX_NEW_TOKENS=512
TEMPERATURE=0.7

# ── 임베딩 ──────────────────────────────
# 텍스트 임베딩 모델
# 옵션: jhgan/ko-sroberta-multitask (기본), sentence-transformers의 다른 모델들
EMBEDDING_MODEL=jhgan/ko-sroberta-multitask

# ── ChromaDB ─────────────────────────────
# 벡터 DB 저장 경로
CHROMA_DB_PATH=./chroma_db

# ChromaDB 컬렉션 이름
CHROMA_COLLECTION=medical_knowledge

# ── 검색 설정 ────────────────────────────
# 검색 결과 개수
TOP_K=5

# 하이브리드 검색 활성화 (BM25 + Dense 벡터)
USE_HYBRID=false

# 하이브리드 검색 가중치 (0.0~1.0, Dense 가중치)
# 높을수록 Dense 검색 우선, 낮을수록 BM25 우선
HYBRID_ALPHA=0.7

# ── 서버 설정 ────────────────────────────
# FastAPI 서버 포트
API_PORT=8000

# Streamlit 포트 (기본값: 8501)
STREAMLIT_PORT=8501

# CORS 허용 도메인 (콤마로 구분)
CORS_ORIGINS=http://localhost:3000,http://localhost:8501

# ── 로깅 ─────────────────────────────────
# 로깅 레벨: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# 로그 파일 경로 (선택사항)
LOG_FILE=./logs/app.log
